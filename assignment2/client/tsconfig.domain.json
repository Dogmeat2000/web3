{
  "include": ["../domain/src/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "../domain/src",
    "declarationDir": "./node_modules/.tmp/domain-types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.domain.tsbuildinfo",

    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": []
  }
}
