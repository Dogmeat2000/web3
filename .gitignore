# The six sub-projects
!/assignment1/
!/assignment2/
!/assignment3/
!/assignment4/
!/assignment5/
!/assignment6/

# CI / repository metadata
!/.github/
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/LICENSE

# Workspace + shared tooling config (uncomment or extend as you adopt them)
!/package.json
!/pnpm-workspace.yaml
!/turbo.json
!/tsconfig.base.json
!/tsconfig.json
!/.nvmrc
!/.npmrc
!/pnpm-lock.yaml
!/package-lock.json
!/yarn.lock

# Root-level dotfolders that must stay ignored even though they are listed
# above by pattern order — re-excluded explicitly for clarity.
/node_modules/
/.turbo/
/.vscode/
/.idea/


# ----------------------------------------------------------------------------
# Dependencies
# ----------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/
.pnpm-store/

# Yarn Berry (PnP). Keep the files that make installs reproducible.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Lockfiles are intentionally NOT ignored. Commit exactly one per workspace root
# (package-lock.json | pnpm-lock.yaml | yarn.lock).


# ----------------------------------------------------------------------------
# Build output
# ----------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
lib-cov/
*.tsbuildinfo
.tsbuildinfo

# Next.js
.next/
.next-env.d.ts.timestamp
.vercel/
.netlify/

# Nuxt (if any Vue app graduates to Nuxt)
.nuxt/
.output/
.nitro/
.data/

# Storybook
storybook-static/


# ----------------------------------------------------------------------------
# Task runners & build caches
# ----------------------------------------------------------------------------
.turbo/
.nx/cache/
.nx/workspace-data/
.rollup.cache/
.parcel-cache/
.swc/
.cache/
.temp/
.tmp/
tmp/
*.tsbuildinfo.json

# Linter / formatter caches
.eslintcache
.stylelintcache
.prettiercache


# ----------------------------------------------------------------------------
# Testing (Vitest, Jest, Playwright, Cypress)
# ----------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/
cypress/screenshots/
cypress/videos/

# Vitest HTML reporter / UI output
html/

# NOTE: __snapshots__/ is deliberately NOT ignored — snapshots are reviewed
# artifacts and belong in version control.


# ----------------------------------------------------------------------------
# GraphQL
# ----------------------------------------------------------------------------
# Persisted-query and introspection artifacts produced at build time.
.graphqlconfig-cache/
persisted-query-manifest.json
introspection.json
schema.json

# Codegen output — UNCOMMENT ONLY IF your CI regenerates types before tsc.
# If consumers type-check without running codegen first, COMMIT these instead.
# **/__generated__/
# *.generated.ts
# *.generated.tsx
# src/gql/


# ----------------------------------------------------------------------------
# Environment & secrets
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
!.env.defaults

# Credentials / certificates
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.json
.secrets/


# ----------------------------------------------------------------------------
# Logs & diagnostics
# ----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.heapsnapshot
*.cpuprofile


# ----------------------------------------------------------------------------
# Editors & IDEs
# ----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/


# ----------------------------------------------------------------------------
# Operating system noise
# ----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# ----------------------------------------------------------------------------
# Local-only overrides
# ----------------------------------------------------------------------------
*.local
local.*
.local/
